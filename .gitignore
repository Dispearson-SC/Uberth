.venv/
__pycache__/
*.pyc
fixtures/*.graphml
fixtures/*.parquet
.atl/
.env
cache/
fixtures/raw/*.graphml
*.tmp.*
*.py.tmp*
fixtures/raw/tomtom_monterrey_areaanalysis.json


# Datasets stay out of git; documentation stays in. A trailing-slash
# pattern cannot be negated from inside, hence Docs/* rather than Docs/.
Docs/*
!Docs/*.md
!Docs/architecture/

# Claude Code project config. Kept OUT of the repository on purpose: `.mcp.json`
# names a private Coolify endpoint, and this repository is public. The token
# itself is never in the file -- it is a ${COOLIFY_TOKEN} reference read from
# the environment -- but the endpoint is still infrastructure nobody needs to
# know about. Delete these two lines if this ever becomes a shared, private repo
# and the MCP server should travel with it.
.mcp.json
.claude/

# Capturas para la galería del pitch. Locales a propósito: son material de
# presentación, no del proyecto, y son 2.6 MB de JPEG que nadie que clone el
# repo necesita. El tablero que las produce sí está versionado.
screenshots/
